{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist-cli",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/cli.ts", "src/witnesses.ts", "src/managed/**/*"],
  "exclude": ["src/**/*.tsx", "src/App.tsx", "src/main.tsx", "src/ui/**/*", "src/**/*.test.ts"]
}