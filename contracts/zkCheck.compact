pragma language_version 0.23;

import CompactStandardLibrary;

struct Proceso {
  ingresoMaximo: Uint<32>,
  promedioMinimo: Uint<8>,
  edadMinima: Uint<8>,
  edadMaxima: Uint<8>,
  activo: Boolean,
}

export ledger procesos: Map<Bytes<32>, Proceso>;
export ledger elegibles: Map<Bytes<32>, Boolean>;

witness datosPostulante(): [Uint<32>, Uint<8>, Uint<8>];
witness secretoPostulante(): Bytes<32>;

circuit postulanteId(procesoId: Bytes<32>): Bytes<32> {
  const sk = secretoPostulante();
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "beca:postulante:"),
    procesoId,
    sk
  ]);
}

export circuit crearProceso(
  procesoId: Bytes<32>,
  ingresoMaximo: Uint<32>,
  promedioMinimo: Uint<8>,
  edadMinima: Uint<8>,
  edadMaxima: Uint<8>
): [] {
  procesos.insert(
    disclose(procesoId), 
    Proceso {
      ingresoMaximo: disclose(ingresoMaximo),
      promedioMinimo: disclose(promedioMinimo),
      edadMinima: disclose(edadMinima),
      edadMaxima: disclose(edadMaxima),
      activo: disclose(true),
    }
  );
}

export circuit postular(procesoId: Bytes<32>): [] {
  const pId = disclose(procesoId);
  assert(procesos.member(pId), "Proceso inexistente");
  const proceso = procesos.lookup(pId);
  assert(proceso.activo, "Proceso cerrado");

  const [ingreso, promedio, edad] = datosPostulante();

  const cumpleIngreso = ingreso <= proceso.ingresoMaximo;
  const cumplePromedio = promedio >= proceso.promedioMinimo;
  const cumpleEdad = edad >= proceso.edadMinima && edad <= proceso.edadMaxima;
  const esElegible = cumpleIngreso && cumplePromedio && cumpleEdad;

  const id = disclose(postulanteId(procesoId));
  assert(!elegibles.member(id), "Ya te postulaste a este proceso");
  elegibles.insert(id, disclose(esElegible));
}
