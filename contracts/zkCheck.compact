pragma language_version 0.23;

import CompactStandardLibrary;

export ledger totalPostulaciones: Counter;
export ledger elegibles: Map<Bytes<32>, Boolean>;
export ledger reclamos: Map<Bytes<32>, Bytes<32>>;

witness datosPostulante(): [Uint<32>, Uint<8>, Uint<8>];
witness secretoPostulante(): Bytes<32>;
witness contactoPostulante(): Bytes<32>;

circuit cumpleCriterios(ingreso: Uint<32>, promedio: Uint<8>, edad: Uint<8>): Boolean {
  const cumpleIngreso = ingreso <= 1500000;
  const cumplePromedio = promedio >= 75;
  const cumpleEdad = edad >= 18 && edad <= 25;
  return cumpleIngreso && cumplePromedio && cumpleEdad;
}

circuit postulanteId(): Bytes<32> {
  const sk = secretoPostulante();
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "beca:postulante:"),
    sk
  ]);
}

export circuit postular(): [] {
  const [ingreso, promedio, edad] = datosPostulante();
  const esElegible = cumpleCriterios(ingreso, promedio, edad);

  const id = disclose(postulanteId());
  assert(!elegibles.member(id), "Ya te postulaste");
  elegibles.insert(id, disclose(esElegible));
  totalPostulaciones.increment(1);
}

export circuit reclamarBeca(): [] {
  const id = disclose(postulanteId());

  assert(elegibles.member(id), "No te postulaste");
  assert(elegibles.lookup(id), "No sos elegible para esta beca");
  assert(!reclamos.member(id), "Ya reclamaste esta beca");

  const contacto = contactoPostulante();
  reclamos.insert(id, disclose(contacto));
}